classDiagram
  class Backend {
    <<abstract>>
    +linktype: int
    +open()
    +read() bytes, timestamp
    +close()
  }
  class LibpcapBackend {
    -lib: ctypes.CDLL
    +list_devices()
  }
  class LinuxRawSocket
  class PcapReader
  Backend <|-- LibpcapBackend
  Backend <|-- LinuxRawSocket
  Backend <|-- PcapReader

  class BackendFactory {
    +open_backend(iface, prefer) Backend
  }
  BackendFactory ..> Backend

  class Layer {
    <<abstract>>
    +name: str
    +header_len: int
    +payload: bytes
    +parse(data: bytes, ctx) Layer
    +next_protocol() key
    +validate(ctx) ChecksumResult
  }
  Layer <|-- Ethernet
  Layer <|-- LinuxSLL
  Layer <|-- Loopback
  Layer <|-- IPv4
  Layer <|-- IPv6
  Layer <|-- TCP
  Layer <|-- UDP
  Layer <|-- ICMP

  class ChecksumResult {
    +layer: str
    +expected: int
    +computed: int
    +offload_suspected: bool
    +skipped: bool
    +valid: bool
  }

  class Packet {
    +timestamp: float
    +linktype: int
    +raw: bytes
    +layers: list~Layer~
    +checksums: list~ChecksumResult~
    +get(layer_type) Layer
  }

  class Dissector {
    -registry: dict
    +register(key, layer_cls)
    +dissect(raw, ts, linktype) Packet
  }

  class EventBus {
    +subscribe(callback)
    +publish(packet)
  }

  class Sniffer {
    -backend: Backend
    -dissector: Dissector
    -bus: EventBus
    +start()
    +stop()
  }

  Sniffer --> BackendFactory
  Sniffer --> Backend
  Sniffer --> Dissector
  Sniffer --> EventBus
  Dissector --> Layer
  Dissector --> Packet
  Packet --> Layer
  Packet --> ChecksumResult
